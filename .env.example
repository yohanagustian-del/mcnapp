# Supabase project: MCN MEA (bqknstylbpwsnlgnzayw)
NEXT_PUBLIC_SUPABASE_URL=https://bqknstylbpwsnlgnzayw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3XMggPBsF3l5OOyu44MqLg_if-eBwWq
# Service role key (Dashboard > Settings > API). NEVER commit the real value.
# Needed by: bulk upload team_members (auth admin), writeAudit, M4 engine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origin untuk tautan reset password (lupa password). Kalau kosong, origin
# diambil dari header request — set eksplisit di production supaya tautan email
# tidak pernah mengarah ke domain preview.
NEXT_PUBLIC_SITE_URL=https://your-app-domain

# M2 insight layer (LLM). Tanpa key, report tetap tersimpan data-only.
ANTHROPIC_API_KEY=your-anthropic-api-key
# PRD M2 §5: model reasoning ringan cukup — default claude-haiku-4-5.
M2_INSIGHT_MODEL=claude-haiku-4-5

# PX-M3-A: push coverage mingguan ke CDPS (MEAgrup/AgencyAPP) di akhir pipeline
# ingest — lihat docs/BRIDGE_PRODUCT_EXCHANGE_CONTRACT.md + src/lib/px/coverage-push.ts.
# Tanpa keduanya, push dilewati (dilaporkan sebagai coveragePushSkipped, ingest
# tetap sukses) — bukan dianggap gagal.
CDPS_BRIDGE_URL=https://your-cdps-deployment.example.com
# TERPISAH dari SUPABASE_SERVICE_ROLE_KEY/ANTHROPIC_API_KEY di atas — disepakati
# out-of-band dengan sisi CDPS, JANGAN commit nilai asli (preseden D-12/BRIDGE_INGEST_SECRET).
BRIDGE_PX_SECRET=your-shared-bridge-px-secret
